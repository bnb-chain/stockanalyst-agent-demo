# ── Wallet ────────────────────────────────────────────────────────────────────
# Path to the buyer's encrypted keystore JSON
KEYSTORE_PATH=../stockanalyst/.studio/wallets/<buyer-wallet>.json

# Keystore decryption password (same as WALLET_PASSWORD in stockanalyst/.studio/.env.local)
WALLET_PASSWORD=your_wallet_password_here

# ── ERC-8183 flow  (npm run dev) ──────────────────────────────────────────────
# Cloud seller A2A endpoint — from `bag deploy` output (bnbagent-api.bnbchain.world/…/a2a)
AGENT_ENDPOINT=https://bnbagent-api.bnbchain.world/v1/rt/<runtime-id>/a2a

# OAuth2 Cognito credentials — from `bag deploy provision-cognito`
# Leave blank for local agent (no auth required)
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=

# ── AWS AgentCore runtime overrides ──────────────────────────────────────────
# Raw AgentCore invocation URL:
# https://bedrock-agentcore.<region>.amazonaws.com/runtimes/<agent-runtime-arn>/invocations?qualifier=DEFAULT
# Its Cognito issuer and resource-server scope are separate from the runtime URL.
# AGENT_TOKEN_URL=https://<domain>.auth.<region>.amazoncognito.com/oauth2/token
# AGENT_OAUTH_SCOPE=<resource-server-identifier>/<scope>
# Optional: must be at least 33 characters. Leave unset to generate one stable
# value per buyer process; it is sent only to the AgentCore runtime.
# AGENT_SESSION_ID=<stable-session-id-at-least-33-characters>

# Required for an AWS S3/CloudFront seller: disables the buyer-hosted relay and
# fetches the seller's external delivery URL directly. The existing external
# delivery mode name remains "ipfs" for compatibility.
DELIVERY_MODE=ipfs

# Seller wallet address (shown in stockanalyst/app/agent/studio.toml [wallet].address)
PROVIDER_ADDRESS=0xd10BdDC20E4DC42A1a19a9653e994991e25b8153

# ── x402 flows  (npm run x402:async / npm run x402:free) ─────────────────────
# Base URL for the x402 channel. Two modes:
#   Local:    http://localhost:9000           (x402 + A2A share one port — bag dev / python main.py)
#   Deployed: shown by `bag deploy info` as x402_url (a separate public port, no Cognito)
#             e.g. https://bnbagent-api.bnbchain.world/v1/rt/<id>/x402
# Default is localhost:9000; only set this to override.
# X402_ENDPOINT=http://localhost:9000

# Required seller recipient for x402 payment authorizations.
X402_SELLER_WALLET=0xYourSellerWalletAddress

# Free-tier U token EIP-712 domain — the paid B402 flow discovers these values
# from the seller's 402 challenge.
# Verify via: cast call <U_TOKEN> "name()" --rpc-url $BSC_TESTNET_RPC
# U_TOKEN_DOMAIN_NAME=U
# U_TOKEN_DOMAIN_VERSION=1

# ── UOMP Memory Guard ─────────────────────────────────────────────────────────
# Portfolio context store — must be running locally before either flow starts.
# Seed with: node guard-mock.mjs  (from agent-demo root)
UOMP_GUARD_URL=http://127.0.0.1:9374
UOMP_GUARD_TOKEN=your_guard_jwt_token_here
